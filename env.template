# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings > API) ---------------------------------------
# Public: safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SECRET: server only. Bypasses row level security; used to read hidden test
# cases and to write graded submissions. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Google Gemini (https://aistudio.google.com/apikey) ----------------------
# SECRET: server only.
GOOGLE_API_KEY=your-gemini-api-key
# Optional model overrides.
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_CHAT_FALLBACK_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Code sandbox ------------------------------------------------------------
# judge0 (default) | piston | mock (development only; runs nothing)
# SANDBOX_PROVIDER=judge0
# Judge0: defaults to the public Community Edition instance. For production,
# point this at your own instance or a hosted plan and set the key.
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
# Piston (self-hosted; the public API is whitelist-only).
# PISTON_URL=http://localhost:2000/api/v2
# PISTON_API_KEY=
